# Database (Neon Serverless PostgreSQL)
# Get this from your Neon project dashboard → Connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Admin CMS credentials
# Set a strong password — this is NOT hashed; plain-text comparison is used
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# Admin session token secret
# A long random string used as the cookie value to verify admin sessions
ADMIN_SECRET=your-very-long-random-secret-here
